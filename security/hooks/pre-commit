#!/usr/bin/env python3
# Pre-commit hook — Kraefegg M.O.
# Bloqueia o commit se o auditor de segurança detectar violações.
# Não grava trilha de auditoria aqui (evita árvore suja); o agente online
# (GitHub Actions) é quem registra a trilha em security/audit_log.jsonl.
# Ativa: git config core.hooksPath security/hooks
import subprocess, sys
r = subprocess.run(
    [sys.executable, "security/audit_security.py", "--no-audit-log"],
    cwd=r"C:\Users\MEU PC\OneDrive\Documents\KraefeggMO",
)
sys.exit(r.returncode)
