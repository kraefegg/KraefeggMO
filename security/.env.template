# Kraefegg M.O. - Template de credenciais locais (NUNCA versionar valores reais)
# Copie para db/.env e db/mongodb/.env e preencha com valores reais.
# Ver: security/audit_security.py (auditor bloqueia segredos versionados).

# ============================================================
# db/.env  (PostgreSQL - Supabase/Neon de producao)
# ============================================================
SUPABASE_URI="postgresql://postgres.<PROJETO>:<SENHA>@db.<REF>.supabase.co:5432/postgres"

# ============================================================
# db/mongodb/.env  (MongoDB Atlas - telemetria)
# ============================================================
MONGODB_USERNAME=<USUARIO>
MONGODB_PASSWORD=<SENHA>
MONGODB_HOST=cluster0.<CLUSTER>.mongodb.net
# URI de conexao completa (aplicacao + atlas-sql.ps1)
MONGODB_URI="mongodb+srv://<USUARIO>:<SENHA>@cluster0.<CLUSTER>.mongodb.net/?retryWrites=true&w=majority"
